# Settings of the Subtitle Retimer service that are not secret.
# Installed as /etc/retimer/retimer.env. The keys are in secrets.env next to
# it, written by `sudo retimer-secrets`. After a change:
#   sudo systemctl restart retimer
#
# Every setting and its default is in the README, under "What keeps the
# service closed".

RETIMER_DATA_DIR=/var/lib/retimer

# cloudflared runs on this machine and is the only proxy that is believed
# about HTTPS and the address of a client.
RETIMER_TRUSTED_PROXIES=127.0.0.1
