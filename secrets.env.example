# Copy to secrets.env and fill in. Never commit secrets.env.

# Pays for the model, the transcripts and the embeddings: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Who may call the service: one or more entries label:sha256, separated by commas.
# Make one with:  docker compose run --rm --no-deps retimer-api retimer api-key --label jellyfin
# The key it prints goes into the plugin's settings, the entry here.
RETIMER_API_KEYS=
